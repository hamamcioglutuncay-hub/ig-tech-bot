# ig-tech-bot ayarları — bu dosya ÖRNEKTİR, gerçek değer içermez.
# Gerçek değerleri .env dosyasına yaz (.env asla commit edilmez).
# Her satır: AD=değer   (eşittir işaretinin iki yanında boşluk ve tırnak olmasın)

# --- Google Gemini (aistudio.google.com → Get API key) ---
GEMINI_API_KEY=
# Boş bırakılırsa varsayılan model kullanılır; "python -m bot check" önerilen modeli gösterir.
LLM_MODEL=

# --- Cloudflare Workers AI (dash.cloudflare.com) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- Telegram (BotFather'dan alınan token ve kendi chat ID'n) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Instagram (developers.facebook.com → uygulama → Instagram → API setup) ---
# IG_USER_ID: Instagram hesabının sayısal kimliği (panelde hesap adının altındaki 1784… numarası)
IG_USER_ID=
# IGAA… (Instagram login) ya da EAA… (Unified/Facebook login) token — ikisi de desteklenir
IG_ACCESS_TOKEN=
# Token yenileme için: Uygulama ayarları → Temel → Uygulama Kimliği ve Uygulama Gizli Anahtarı
IG_APP_ID=
IG_APP_SECRET=

# --- Çalışma modu: dry-run | approve | auto ---
MODE=dry-run
