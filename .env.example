# ig-tech-bot ayarları — bu dosya ÖRNEKTİR, gerçek değer içermez.
# Gerçek değerleri .env dosyasına yaz (.env asla commit edilmez).
# Her satır: AD=değer   (eşittir işaretinin iki yanında boşluk ve tırnak olmasın)

# --- Google Gemini (aistudio.google.com → Get API key) ---
GEMINI_API_KEY=
# Boş bırakılırsa varsayılan model kullanılır; "python -m bot check" önerilen modeli gösterir.
LLM_MODEL=

# --- Cloudflare Workers AI (dash.cloudflare.com) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- Telegram (BotFather'dan alınan token ve kendi chat ID'n) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Instagram (Faz 4'te doldurulacak, şimdilik boş kalabilir) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Çalışma modu: dry-run | approve | auto ---
MODE=dry-run
